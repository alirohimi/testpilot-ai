# TestPilot AI - Environment Variables
# ====================================

# Application
APP_NAME="TestPilot AI"
APP_ENV="production"  # development, staging, production
DEBUG=false
SECRET_KEY="your-secret-key-here"  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# CORS — comma-separated allowlist. NEVER use "*" with allow_credentials in prod.
# Examples: https://your-frontend.com,https://admin.your-frontend.com
ALLOWED_ORIGINS="https://testpilot-ai.dev,https://admin.testpilot-ai.dev"

# Logging — LOG_FORMAT: "json" (default, for aggregators) or "text" (human)
LOG_FORMAT="json"
LOG_LEVEL="INFO"

# Database
DATABASE_URL="postgresql://testpilot:testpilot@localhost:5432/testpilot"
# or use connection string:
# DATABASE_URL="postgresql://user:pass@host:port/dbname"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Authentication
JWT_SECRET_KEY="your-jwt-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# OpenAI (for LLM analysis)
OPENAI_API_KEY="sk-..."

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_TEAM="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# Sentry (for error tracking) — app inits SDK only when SENTRY_DSN is set.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"  # % of transactions to trace

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASSWORD="your-password"

# Application URLs
FRONTEND_URL="https://testpilot.ai"
API_URL="https://api.testpilot.ai"
